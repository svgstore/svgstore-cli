#!/usr/bin/env node
'use strict';

var fs        = require('node:fs');
var path      = require('node:path');
var util      = require('node:util');
var svgstore  = require('svgstore');


// Define the available command-line options
var argv_options = {
    inline: {
        short: 'i',
        type: 'boolean'
    },
    output: {
        short: 'o',
        type: 'string'
    },
    prefix: {
        short: 'p',
        type: 'string'
    }
};


// Parse the command-line arguments
var args = util.parseArgs({ strict: true, allowPositionals: true, options: argv_options });

var output = args.values.output;
var prefix = args.values.prefix;
var inline = args.values.inline;
var inputs = [];


// Make an array of all the inputs, expanding globs
var inputs = args.positionals.reduce(function(total, files) {
  return total.concat(fs.globSync(files));
}, []);


if (inputs.length == 0) {
    console.error('No input files provided');
    return -1;
}


// Build up the spritesheet
var sprites = inputs.reduce(function(sprites, file) {
    return sprites.add(prefix + path.basename(file, '.svg'), fs.readFileSync(file, 'utf8'));
}, svgstore({ inline: inline, renameDefs: true }));


// Output to file, or to stdout
if (output) {
    fs.writeFileSync(output, sprites.toString({ inline: inline }));
} else {
    console.log(sprites.toString({ inline: inline }));
}
